# CodeAdapt AI - Environment Variables

# Piston Code Execution Engine Configuration:
# - If running Piston locally via Docker (`docker compose up -d`), use:
PISTON_API_URL=http://localhost:2000/api/v2
# - If using a self-hosted cloud instance (e.g., Oracle Free Tier, VPS):
# PISTON_API_URL=https://your-piston-domain.com/api/v2
# - If using official Piston API with an authorized token:
# PISTON_API_URL=https://emkc.org/api/v2/piston
# PISTON_API_KEY=your_piston_whitelist_token

# Optional Gemini AI API Key for adaptive mentoring & problem variations
# GEMINI_API_KEY=your_gemini_api_key_here
